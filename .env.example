# Copy the host and username from Supabase Connect > Session pooler.
# Keep credentials out of this JDBC URL; put them in the separate fields below.
SUPABASE_DB_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Only needed if a separate site origin must call the API.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
